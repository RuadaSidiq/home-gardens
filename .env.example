# ---------------------------------------------------------------
# Core
# ---------------------------------------------------------------
# Public base URL of the site (used in emails, payment callbacks, webhooks)
APP_URL=http://localhost:3000
# PostgreSQL connection string. Supabase: Project Settings -> Database -> Connection string (use the pooler URI for serverless)
DATABASE_URL=postgres://gardens:gardens@localhost:5432/gardens
# 32+ random characters. Generate with: openssl rand -base64 48
AUTH_SECRET=replace-with-a-long-random-string
# Used to encrypt gardener payout details at rest. 32 bytes base64: openssl rand -base64 32
DATA_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# ---------------------------------------------------------------
# File storage. "local" stores files under ./uploads (single server only).
# "s3" works with Supabase Storage (S3 protocol), AWS S3, Cloudflare R2, etc.
# ---------------------------------------------------------------
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_PUBLIC=public-media
S3_BUCKET_PRIVATE=private-documents
# Public URL prefix for objects in the public bucket, e.g. https://<project>.supabase.co/storage/v1/object/public/public-media
S3_PUBLIC_URL=

# ---------------------------------------------------------------
# Payments (leave blank to keep a provider disabled)
# ---------------------------------------------------------------
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_MERCHANT_ACCOUNT=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox | live
PAYPAL_MODE=sandbox

# ---------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------
EMAIL_FROM="Home Gardens <hello@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Alternatively use Resend instead of SMTP
RESEND_API_KEY=
# SMS via Hubtel (Ghana) or Twilio (international)
HUBTEL_SMS_CLIENT_ID=
HUBTEL_SMS_CLIENT_SECRET=
HUBTEL_SMS_SENDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---------------------------------------------------------------
# AI garden assistant (server-side only, never exposed to the browser)
# ---------------------------------------------------------------
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# ---------------------------------------------------------------
# Monitoring (optional) – any endpoint that accepts JSON error reports
# ---------------------------------------------------------------
ERROR_WEBHOOK_URL=
MANUAL_PAYMENTS_ENABLED=true
# Shared secret for scheduled maintenance calls to /api/cron/maintenance
CRON_SECRET=replace-with-random-string
# Bank / MoMo details shown to customers choosing manual transfer
MANUAL_PAYMENT_INSTRUCTIONS="Bank: Example Bank Ghana, Account: Home Gardens Ltd, No. 0000000000. MoMo: 020 000 0000 (Home Gardens). Use your payment reference as the description."
